# Пример настроек. Скопируйте в backend/.env (локально) или задайте переменные окружения на хостинге.
# Реальные секреты в репозиторий не коммитятся (.env в .gitignore).

APP_ENV=production                 # production отключает /api/docs
DATABASE_URL=sqlite:////data/deanate.db   # или postgresql://user:password@host:5432/dbname
COOKIE_SECURE=true                 # true при работе через HTTPS (обязательно в production)
TRUST_PROXY_HEADERS=true           # учитывать X-Forwarded-For за обратным прокси хостинга
SESSION_TTL_HOURS=72
SESSION_IDLE_MINUTES=720
LOGIN_RATE_LIMIT=10                # попыток входа на IP+логин за окно
LOGIN_RATE_WINDOW_SECONDS=300

SEED_ON_STARTUP=true               # заполнить пустую БД демо-данными при старте
# Пароли демо-аккаунтов (тестовые, вымышленные). Применяются только при первом заполнении БД.
DEMO_PASSWORD_STUDENT1=student1-demo
DEMO_PASSWORD_STUDENT2=student2-demo
DEMO_PASSWORD_STAFF=dekanat-demo

UNIVERSITY_NAME=Технический университет
TIMEZONE=Europe/Moscow
# DEMO_TODAY=2026-11-23            # зафиксировать «сегодня» (для тестов/записи демо); по умолчанию — реальная дата
